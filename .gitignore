.env
.env.*
!.env.example

# Local runtime state. `data/` holds user records (password hashes) and
# encrypted venue credentials; `.secrets.key` is the key that decrypts them.
# Committing either would put real credentials in the history.
data/
.secrets.key
__pycache__/
*.pyc
.venv/
venv/
.remember/
.DS_Store
.superpowers/
.coverage
htmlcov/

# local planning ledger (briefs/reports)
.plan/

# local agent/editor configuration
.claude/

# Python build artefacts (regenerated by any install; never source).
*.egg-info/
